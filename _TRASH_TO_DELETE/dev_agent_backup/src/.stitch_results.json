{
  "16682207781060267797:167cf99698b84a2eb3f0b21a6afea1bc:Add 4 KPI metric cards at top and a data table below. Keep existing blue #0056B3 theme.": "<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>B\u1ea3ng \u0111i\u1ec1u khi\u1ec3n - Qu\u1ea3n l\u00fd \u0110\u00e0o t\u1ea1o</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,0&display=swap\" rel=\"stylesheet\">\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Inter', sans-serif; background: #f9f9ff; color: #191c21; }\n:root {\n  --md-primary: #003f87;\n  --md-primary-container: #0056b3;\n  --md-on-primary: #ffffff;\n  --md-surface: #f9f9ff;\n  --md-surface-container-low: #f2f3fc;\n  --md-surface-container: #ededf6;\n  --md-surface-container-lowest: #ffffff;\n  --md-on-surface: #191c21;\n  --md-on-surface-variant: #424752;\n  --md-outline-variant: #c2c6d4;\n  --md-outline: #727784;\n  --md-green: #047857;\n  --md-green-bg: #ecfdf5;\n  --md-red: #b91c1c;\n  --md-red-bg: #fef2f2;\n  --md-amber: #d97706;\n  --md-amber-bg: #fffbeb;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --radius-full: 9999px;\n  --shadow-card: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);\n  --shadow-elevated: 0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -2px rgba(0,0,0,0.05);\n}\n.sidebar { position: fixed; left: 0; top: 0; width: 260px; height: 100vh; background: var(--md-surface-container-low); border-right: 1px solid var(--md-outline-variant); padding: 24px 16px; display: flex; flex-direction: column; gap: 4px; }\n.sidebar-brand { display: flex; align-items: center; gap: 12px; padding: 8px 12px 24px; border-bottom: 1px solid var(--md-outline-variant); margin-bottom: 16px; }\n.sidebar-brand .logo { width: 40px; height: 40px; background: linear-gradient(135deg, var(--md-primary-container), var(--md-primary)); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: white; }\n.sidebar-brand .brand-text { font-weight: 700; font-size: 16px; line-height: 1.2; }\n.sidebar-brand .brand-sub { font-size: 11px; color: var(--md-on-surface-variant); letter-spacing: 0.03em; }\n.nav-item { display: flex; align-items: center; gap: 12px; padding: 10px 16px; border-radius: var(--radius-md); color: var(--md-on-surface-variant); text-decoration: none; font-size: 15px; font-weight: 500; cursor: pointer; transition: all 0.15s ease; }\n.nav-item:hover { background: var(--md-surface-container-high); }\n.nav-item.active { background: var(--md-primary-fixed); color: var(--md-primary); font-weight: 600; }\n.main { margin-left: 260px; padding: 32px 40px; max-width: 1400px; }\n.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }\n.header-left h1 { font-size: 36px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }\n.header-left p { color: var(--md-on-surface-variant); font-size: 16px; margin-top: 4px; }\n.header-right { display: flex; align-items: center; gap: 16px; }\n.kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 32px; }\n.kpi-card { background: var(--md-surface-container-lowest); padding: 24px; border-radius: var(--radius-lg); box-shadow: var(--shadow-elevated); border: 1px solid var(--md-outline-variant); }\n.kpi-card .kpi-value { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; padding: 12px 0 4px; }\n.kpi-card .kpi-label { color: var(--md-on-surface-variant); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 24px 24px; display: flex; justify-content: space-between; }\n.delta-green { color: var(--md-green); font-weight: 600; }\n.delta-red { color: var(--md-red); font-weight: 600; }\n.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }\n.section-header h2 { font-size: 24px; font-weight: 600; }\n.data-table { width: 100%; border-collapse: collapse; background: var(--md-surface-container-lowest); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-card); border: 1px solid var(--md-outline-variant); }\n.data-table th { font-size: 12px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--md-on-surface-variant); padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--md-outline-variant); background: var(--md-surface); }\n.data-table td { padding: 14px 16px; border-bottom: 1px solid var(--md-surface-container); font-size: 14px; }\n.data-table tr:hover td { background: var(--md-surface-container-low); }\n.chip { display: inline-flex; align-items: center; padding: 4px 12px; border-radius: var(--radius-full); font-size: 11px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }\n.chip-green { background: var(--md-green-bg); color: var(--md-green); }\n.chip-amber { background: var(--md-amber-bg); color: var(--md-amber); }\n.chip-red { background: var(--md-red-bg); color: var(--md-red); }\n</style>\n</head>\n<body>\n<div class=\"sidebar\">\n  <div class=\"sidebar-brand\">\n    <div class=\"logo\"><span class=\"material-symbols-outlined\">school</span></div>\n    <div><div class=\"brand-text\">Qu\u1ea3n l\u00fd T04</div><div class=\"brand-sub\">H\u1ec7 th\u1ed1ng \u0111\u1ecbnh m\u1ee9c</div></div>\n  </div>\n  <div class=\"nav-item active\"><span class=\"material-symbols-outlined\">dashboard</span>B\u1ea3ng \u0111i\u1ec1u khi\u1ec3n</div>\n  <div class=\"nav-item\"><span class=\"material-symbols-outlined\">groups</span>Qu\u1ea3n l\u00fd C\u00e1n b\u1ed9</div>\n  <div class=\"nav-item\"><span class=\"material-symbols-outlined\">edit_note</span>Nh\u1eadt k\u00fd Ho\u1ea1t \u0111\u1ed9ng</div>\n  <div class=\"nav-item\"><span class=\"material-symbols-outlined\">settings</span>C\u00e0i \u0111\u1eb7t H\u1ec7 th\u1ed1ng</div>\n</div>\n<div class=\"main\">\n  <div class=\"header\">\n    <div class=\"header-left\">\n      <h1>B\u1ea3ng \u0111i\u1ec1u khi\u1ec3n</h1>\n      <p>N\u0103m h\u1ecdc 2024-2025</p>\n    </div>\n    <div class=\"header-right\">\n      <span class=\"material-symbols-outlined\" style=\"cursor:pointer;color:var(--md-on-surface-variant);\">notifications</span>\n      <span class=\"material-symbols-outlined\" style=\"cursor:pointer;color:var(--md-on-surface-variant);\">help</span>\n    </div>\n  </div>\n\n  <div class=\"kpi-grid\">\n    <div class=\"kpi-card\" style=\"padding:24px;\">\n      <span class=\"material-symbols-outlined\" style=\"color:var(--md-on-surface-variant);\">groups</span>\n      <div class=\"kpi-value\">248</div>\n      <div class=\"kpi-label\"><span>T\u1ed5ng s\u1ed1 gi\u1ea3ng vi\u00ean</span><span class=\"delta-green\">+12</span></div>\n    </div>\n    <div class=\"kpi-card\" style=\"padding:24px;\">\n      <span class=\"material-symbols-outlined\" style=\"color:var(--md-on-surface-variant);\">assignment</span>\n      <div class=\"kpi-value\">42,500</div>\n      <div class=\"kpi-label\"><span>T\u1ed5ng \u0111\u1ecbnh m\u1ee9c GC</span></div>\n    </div>\n    <div class=\"kpi-card\" style=\"padding:24px;\">\n      <span class=\"material-symbols-outlined\" style=\"color:var(--md-on-surface-variant);\">task_alt</span>\n      <div class=\"kpi-value\">31,875</div>\n      <div class=\"kpi-label\"><span>GC \u0111\u00e3 th\u1ef1c hi\u1ec7n</span><span class=\"delta-green\">75%</span></div>\n    </div>\n    <div class=\"kpi-card\" style=\"padding:24px;\">\n      <span class=\"material-symbols-outlined\" style=\"color:var(--md-on-surface-variant);\">pending_actions</span>\n      <div class=\"kpi-value\">12</div>\n      <div class=\"kpi-label\"><span>Ch\u1edd x\u1eed l\u00fd</span><span class=\"delta-red\">+3</span></div>\n    </div>\n  </div>\n\n  <div class=\"section-header\">\n    <h2>Hi\u1ec7u su\u1ea5t gi\u1ea3ng d\u1ea1y</h2>\n    <span style=\"color:var(--md-primary);font-size:14px;font-weight:600;cursor:pointer;\">Xem t\u1ea5t c\u1ea3</span>\n  </div>\n\n  <table class=\"data-table\">\n    <thead><tr>\n      <th>H\u1ecd v\u00e0 t\u00ean</th><th>\u0110\u01a1n v\u1ecb</th><th>Ch\u1ee9c danh</th><th>\u0110\u1ecbnh m\u1ee9c GC</th><th>Th\u1ef1c hi\u1ec7n GC</th><th>\u0110\u1ecbnh m\u1ee9c NCKH</th><th>Th\u1ef1c hi\u1ec7n NCKH</th><th>Ch\u00eanh l\u1ec7ch</th><th>Tr\u1ea1ng th\u00e1i</th>\n    </tr></thead>\n    <tbody>\n      <tr>\n        <td>Nguy\u1ec5n V\u0103n A</td><td>Khoa CNTT</td><td>Gi\u1ea3ng vi\u00ean ch\u00ednh</td><td>280</td><td>300</td><td>100</td><td>120</td>\n        <td><span style=\"color:var(--md-green);font-weight:600;\">+40</span></td>\n        <td><span class=\"chip chip-green\">ho\u00e0n th\u00e0nh</span></td>\n      </tr>\n      <tr>\n        <td>Tr\u1ea7n Th\u1ecb B</td><td>Khoa Kinh t\u1ebf</td><td>Gi\u1ea3ng vi\u00ean</td><td>280</td><td>265</td><td>100</td><td>100</td>\n        <td><span style=\"color:var(--md-red);font-weight:600;\">-15</span></td>\n        <td><span class=\"chip chip-amber\">thi\u1ebfu</span></td>\n      </tr>\n      <tr>\n        <td>L\u00ea V\u0103n C</td><td>Khoa Ngo\u1ea1i ng\u1eef</td><td>Gi\u1ea3ng vi\u00ean</td><td>280</td><td>280</td><td>100</td><td>100</td>\n        <td><span style=\"color:var(--md-on-surface-variant);\">0</span></td>\n        <td><span class=\"chip chip-green\">\u0111\u1ea1t</span></td>\n      </tr>\n      <tr>\n        <td>Ph\u1ea1m Th\u1ecb D</td><td>Khoa CNTT</td><td>Gi\u1ea3ng vi\u00ean cao c\u1ea5p</td><td>200</td><td>220</td><td>150</td><td>160</td>\n        <td><span style=\"color:var(--md-green);font-weight:600;\">+30</span></td>\n        <td><span class=\"chip chip-green\">ho\u00e0n th\u00e0nh</span></td>\n      </tr>\n    </tbody>\n  </table>\n</div>\n</body>\n</html>"
}